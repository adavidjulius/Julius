# ══════════════════════════════════════════════════════════════════════════════
# Julius Open-Source Agent Platform — Environment Configuration
# Copy this file to .env and fill in your API keys and preferences.
# ══════════════════════════════════════════════════════════════════════════════

# ── Primary LLM Provider: NVIDIA Build NIM (Free 550B Default) ───────────────
# Get your free API key at: https://build.nvidia.com/explore/discover
# Provides 1,000 free credits with 40 RPM streaming Nemotron-3-Ultra 550B
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_RPM=40
NVIDIA_SAFETY_RPM=36
NVIDIA_MIN_SPACING=1.5
NVIDIA_TIMEOUT=180

# ── Secondary & Alternative LLM Cloud Providers (Optional) ────────────────────
# Anthropic Claude (e.g. claude-3-7-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# OpenAI (e.g. gpt-4o, o3-mini)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# DeepSeek Cloud API (e.g. deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# Google Gemini (e.g. gemini-2.5-pro, gemini-2.0-flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Groq (Ultra low-latency inference: Llama 3.3 70B, etc.)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ── Local LAN Ollama LLM (Dual-Mode: Local API with Fallback) ─────────────────
# Set to local or network Ollama instance (e.g., http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LOCAL_LLM_TIMEOUT=180
OLLAMA_NUM_CTX=32768
JULIUS_DEFAULT_MODEL=nvidia

# ── Server & Security ────────────────────────────────────────────────────────
# Julius administrative dashboard credentials
JULIUS_ADMIN_USERNAME=admin
JULIUS_ADMIN_EMAIL=admin@example.com
JULIUS_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE
JULIUS_DATA_DIR=~/.julius
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8788
JULIUS_MIN_PASSWORD_LENGTH=12
JULIUS_SESSION_TTL=2592000
JULIUS_SECURE_COOKIES=false
JULIUS_LOGIN_RATE_LIMIT=10
JULIUS_LOGIN_RATE_WINDOW=60

# ── Spotify Metadata Integration (Optional) ──────────────────────────────────
# Register your app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# ── Lossless Audio Ingestion & Providers (Optional) ──────────────────────────
MUSIC_DOWNLOAD_DIR=~/.julius/music_library
MUSIC_TEMP_DIR=~/.julius/tmp_music_downloads
MUSIC_MAX_CONCURRENT_DOWNLOADS=3
MUSIC_PROVIDER_SPOTIFLAC_ENABLED=true
MUSIC_PROVIDER_LOCAL_ENABLED=true
SPOTIFLAC_CLI_PATH=spotiflac
SPOTIFLAC_TIMEOUT_SECONDS=180
MUSIC_QUALITY_POLICY=flac_only
MUSIC_MATCH_THRESHOLD=80.0

# ── WhatsApp Personal Peer Agent (Optional) ──────────────────────────────────
# Keep disabled until WhatsApp Web has been linked through the portal.
WHATSAPP_ENABLED=false
WHATSAPP_AUTO_START=false
WHATSAPP_DEFAULT_MODE=approval
WHATSAPP_UNKNOWN_CHATS_MODE=off
WHATSAPP_HEADLESS=true
WHATSAPP_PROFILE_DIR=~/.julius/whatsapp_profile
WHATSAPP_LLM_PROFILE_DIR=~/.julius/whatsapp_llm_profile
WHATSAPP_LLM_TIMEOUT=90
